# Copy to `.env` and fill in real values. NEVER commit your real `.env`.

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o
OPENAI_TIMEOUT=90
OPENAI_MAX_RETRIES=5
# Fallback price (USD per 1K tokens) for models not in usage.py's table:
OPENAI_PRICE_IN=0.0025
OPENAI_PRICE_OUT=0.01

# ── Target repository (the code the agent edits — NOT this repo) ────────────
LOCAL_REPO_PATH=/absolute/path/to/target/repo
DEFAULT_BRANCH=main
# Per-run git worktrees live here (default: system temp):
# WORKTREE_BASE=/tmp/coding-agent-worktrees

# ── Pipeline behavior ───────────────────────────────────────────────────────
MAX_CODE_RETRIES=3
RUN_BUDGET_USD=0            # soft per-run cost cap; 0 disables
DEPLOY_COMMAND=            # optional; blank = deploy is a no-op
CHECKPOINT_DB_PATH=checkpoints.sqlite

# ── Command sandbox ─────────────────────────────────────────────────────────
SANDBOX_DOCKER=auto        # auto | on | off
SANDBOX_IMAGE=python:3.12-slim   # use a node-capable image for JS/TS repos
SANDBOX_NETWORK=none       # none | bridge | host
SANDBOX_MEMORY=2g
SANDBOX_CPUS=2
SANDBOX_PIDS=512

# ── GitHub (for the optional PR manager) ────────────────────────────────────
GITHUB_TOKEN=ghp_your_token_with_repo_scope
GITHUB_REPO=owner/repo

# ── Auth & CORS ─────────────────────────────────────────────────────────────
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
# Comma-separated browser origins allowed to call the API / WebSocket:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Optional: LangSmith tracing ─────────────────────────────────────────────
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=ls-your-key
# LANGSMITH_PROJECT=my-coding-agent
